<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 宣告 GPS 定位權限:用於偵測車輛時速與轉彎角度 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- MediaProjection 畫面鏡像前景服務權限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 只宣告「可以被啟動的 App」,取代 QUERY_ALL_PACKAGES -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.spotify.music" />
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Launcher"
        android:allowBackup="false"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        tools:ignore="DataExtractionRules">

        <!-- 桌面 (Launcher) 入口:HOME + DEFAULT 讓系統把它當成可選的桌面 -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".AppsActivity" android:exported="false" />
        <activity android:name=".SplitManagerActivity" android:exported="false" />

        <!-- 外接儀表板全螢幕投影視窗 -->
        <activity
            android:name=".ClusterDisplayActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="com.aibox.launcher.cluster"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density" />

        <!-- 半屏分割用 3D 車輛模擬大道視窗 -->
        <activity
            android:name=".CarHalfActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.aibox.launcher.car3d"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density" />

        <!-- MediaProjection 外接儀表板畫面鏡像服務 -->
        <service
            android:name=".ClusterMirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Spotify App Remote 背景續播服務 -->
        <service
            android:name=".SpotifyResumeService"
            android:exported="false" />

        <!-- 無障礙服務:承載虛擬導覽列 -->
        <service
            android:name=".NavService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
